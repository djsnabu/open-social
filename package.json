{
  "name": "open-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted social publishing for people and agents",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env server/main.js",
    "mcp": "node server/mcp.js",
    "dev": "node --watch --env-file-if-exists=.env server/main.js",
    "test": "node --test",
    "check": "node --check server/app.js && node --check public/app.js && node --check server/mcp.js",
    "test:browser": "node scripts/browser-check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.0"
  }
}
